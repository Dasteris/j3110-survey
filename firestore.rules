rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Аккаунты создаёт scripts/setup-firebase.js: uid = ИСУ, у старосты custom claim admin = true.
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    // Опрос про прошедшую неделю: понедельник ПРОШЛОЙ недели по Москве (UTC+3), YYYY-MM-DD —
    // то же, что getSurveyWeekId() в common.js.
    function surveyWeekId() {
      let msk = request.time + duration.value(3, 'h') - duration.value(7, 'd');
      let monday = msk - duration.value(msk.dayOfWeek() - 1, 'd');
      return string(monday.year()) + '-' + pad2(monday.month()) + '-' + pad2(monday.day());
    }

    match /weeks/{weekId}/responses/{isu} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == isu);
      allow create, update: if signedIn()
        && request.auth.uid == isu
        && weekId == surveyWeekId()
        && request.resource.data.keys().hasOnly(['isu', 'weekId', 'updatedAt', 'subjects', 'wellbeing'])
        && request.resource.data.isu == isu
        && request.resource.data.weekId == weekId
        && request.resource.data.updatedAt == request.time;
    }

    // Для collectionGroup('responses') в дашборде — только чтение и только староста.
    match /{path=**}/responses/{isu} {
      allow read: if isAdmin();
    }

    match /roster/{isu} {
      allow read: if isAdmin();
    }
  }
}
